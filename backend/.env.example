# ==============================================================================
# Ojas Backend Environment Configuration
# ==============================================================================

PROJECT_NAME="Ojas - Astronaut Health Monitoring Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"       # Options: development, staging, production
DEBUG=True                      # Set to False in production
PORT=8080                       # Cloud Run dynamically overrides this to $PORT

# Database Configuration:
# - Local SQLite (Default):
DATABASE_URL="sqlite:///./ojas.db"
# - Production Cloud SQL (PostgreSQL):
# DATABASE_URL="postgresql+psycopg2://<DB_USER>:<DB_PASS>@/<DB_NAME>?host=/cloudsql/<PROJECT_ID>:<REGION>:<INSTANCE_NAME>"
# - External Hosted PostgreSQL (Neon / Supabase / Render):
# DATABASE_URL="postgresql+psycopg2://user:password@hostname:5432/ojas"

# CORS Configuration:
# Comma-separated list or JSON array of allowed origins (e.g. deployed frontend URL)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
# In production, replace or append your deployed frontend domain:
# CORS_ORIGINS="https://ojas-web.web.app,https://ojas-web-xyz.a.run.app,http://localhost:5173"

# Baseline & Anomaly Configuration
MIN_READINGS_FOR_BASELINE=5
MIN_READINGS_FOR_ML_ANOMALY=20
ALERT_DEDUPLICATION_WINDOW_MINUTES=30
